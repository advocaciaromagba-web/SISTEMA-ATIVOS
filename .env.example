# =====================================================================
# CONFIGURACAO DO SISTEMA — copie este arquivo para ".env" e preencha.
# NUNCA envie o arquivo .env para o Git nem cole senhas em conversa.
# =====================================================================

# --- Banco de dados (PostgreSQL) -------------------------------------
# Crie um banco novo, exclusivo deste sistema. Na Railway: New > Database
# > PostgreSQL, depois copie a variavel DATABASE_URL do painel.
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedobanco"

# --- Login e sessao ---------------------------------------------------
# Endereco onde o sistema roda. Em producao: https://seudominio.com.br
NEXTAUTH_URL="http://localhost:3000"
# Chave secreta que assina a sessao. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# --- Identidade da plataforma (empresa gestora) -----------------------
# Tudo aqui aparece nas telas e no rodape dos documentos. Trocar aqui muda
# a marca inteira, sem mexer no codigo.
MARCA_NOME="Blackbird"
MARCA_RAZAO_SOCIAL="BLACKBIRD SOLUCOES ESTRATEGICAS LTDA"
MARCA_CNPJ=""
MARCA_EMAIL_SUPORTE=""
MARCA_TELEFONE=""
MARCA_SITE=""
MARCA_CIDADE_FORO="Sao Paulo"
MARCA_UF_FORO="SP"
# Arquivo do logo dentro da pasta /public (ex: /logo.png). Opcional.
MARCA_LOGO="/logo.png"
# Cores da interface (qualquer cor CSS: hex, rgb...).
MARCA_COR="#0f172a"
MARCA_COR_ESCURA="#020617"
MARCA_COR_CLARA="#e2e8f0"
MARCA_COR_CONTRASTE="#ffffff"

# --- Inteligencia artificial ------------------------------------------
# Usada para ler documentos enviados, sugerir preenchimento e apontar riscos.
# A IA SUGERE; quem confirma e o operador. Calculo e validacao ficam no codigo.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Alternativa/complemento (opcional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# --- Cobranca da assinatura (Asaas) -----------------------------------
# Conta propria da empresa gestora. Em teste use "sandbox".
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# --- Assinatura eletronica (Autentique) --------------------------------
AUTENTIQUE_TOKEN=""
# "true" enquanto estiver testando: nao gasta credito.
AUTENTIQUE_SANDBOX="true"

# --- Auditoria: idoneidade e capacidade de pagamento -------------------
# O que ja funciona SEM configurar nada:
#   Receita Federal (CNPJ) — situacao cadastral, capital social, porte, socios
#   OFAC — listas internacionais de sancoes
#
# Cadastros oficiais de empresas punidas (CEIS, CNEP, CEPIM).
# Chave GRATUITA: cadastre um e-mail em
# https://api.portaldatransparencia.gov.br/swagger-ui.html
# Sem ela o sistema nao consegue dizer se a empresa foi declarada inidonea.
TRANSPARENCIA_API_KEY=""

# Divida Ativa da Uniao (PGFN) — NAO precisa de chave.
# O portal Divida Aberta usa captcha invisivel e recusa robo, mas a PGFN
# publica a base inteira em dados abertos. Carregue com:
#   node scripts/importar-divida-ativa.mjs          (FGTS + previdenciario)
#   node scripts/importar-divida-ativa.mjs --tudo   (inclui o nao previdenciario, 1,3 GB)
# O sistema avisa em toda auditoria o que nao foi carregado.

# DataJud (CNJ) — confere se o processo de origem do credito existe.
# Chave publica gratuita, divulgada pelo CNJ na documentacao da API.
DATAJUD_API_KEY=""

# Bureau de credito — protestos, negativacoes, recuperacao judicial, score.
# E a unica fonte que mede capacidade de pagamento de verdade, e a unica que
# cobre pessoa fisica. Exige contrato comercial com CNPJ.
# O Serasa nao tem API aberta; alternativas de contratacao mais simples:
# Assertiva, BigDataCorp, Direct Data.
# Use {documento} na URL onde entra o CPF/CNPJ consultado.
# "serasa" usa o adaptador proprio (OAuth2). Qualquer outro valor usa o
# adaptador generico (BigDataCorp, Direct Data, Assertiva...).
BUREAU_PROVEDOR=""

# --- Serasa Experian (quando BUREAU_PROVEDOR="serasa") -----------------
# Chaves e enderecos vem com o contrato; cada produto tem URL propria.
# Use {documento} na URL onde entra o CPF/CNPJ.
SERASA_CLIENT_ID=""
SERASA_CLIENT_SECRET=""
SERASA_TOKEN_URL=""
SERASA_API_URL_PJ=""
SERASA_API_URL_PF=""

# --- Outro bureau (adaptador generico) ---------------------------------
BUREAU_API_URL=""
BUREAU_API_KEY=""
# "bearer" (padrao), "apikey", ou o nome do cabecalho a usar.
BUREAU_AUTENTICACAO="bearer"

# --- E-mail (SMTP) -----------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_REMETENTE=""
