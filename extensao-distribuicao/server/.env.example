# Só é preciso preencher isto se você ligar "extração assistida por IA" nas
# opções da extensão. Sem isso, a leitura roda inteira no navegador (pdf.js +
# tesseract.js), sem custo.

# Chave da sua própria conta Anthropic. Nunca é enviada para a extensão nem
# para mais ninguém — fica só neste servidor, rodando na sua máquina.
ANTHROPIC_API_KEY=

# Opcional. Padrão: claude-opus-5. Troque por um modelo mais barato (ex.:
# claude-sonnet-5) se o custo por petição pesar mais do que a qualidade da
# extração para o seu volume de casos.
ANTHROPIC_MODEL=claude-opus-5

# Opcional. Porta em que o servidor escuta.
PORTA=8787
