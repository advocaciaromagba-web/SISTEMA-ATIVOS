{
  "manifest_version": 3,
  "name": "Distribuição Processual — OCR",
  "version": "0.1.0",
  "description": "Lê a petição inicial por OCR, organiza os anexos e ajuda a preencher a distribuição processual no PJe, e-SAJ e eproc. Você sempre confirma os dados e clica no protocolo final.",
  "default_locale": "pt_BR",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Distribuição Processual"
  },
  "options_page": "opcoes.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab", "downloads"],
  "host_permissions": [
    "*://*.pje.jus.br/*",
    "*://pje.*.jus.br/*",
    "*://*.tjsp.jus.br/*",
    "*://*.eproc.jus.br/*",
    "*://eproc.*.jus.br/*"
  ],
  "optional_host_permissions": ["*://*.jus.br/*"],
  "content_scripts": [
    {
      "matches": ["*://*.pje.jus.br/*", "*://pje.*.jus.br/*"],
      "js": ["conteudo/pje.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.tjsp.jus.br/*"],
      "js": ["conteudo/esaj.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.eproc.jus.br/*", "*://eproc.*.jus.br/*"],
      "js": ["conteudo/eproc.js"],
      "run_at": "document_idle"
    }
  ]
}
