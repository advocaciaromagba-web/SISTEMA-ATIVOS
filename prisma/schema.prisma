// =====================================================================
// Banco de dados do sistema de intermediacao de ativos.
// PostgreSQL. Cada assinante e uma "Organizacao" e so enxerga os proprios
// dados — a separacao e feita em toda consulta pelo organizacaoId.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ASSINANTE
// ---------------------------------------------------------------------

/// Empresa ou profissional que assina a plataforma. E a caixa que isola os
/// dados: nenhuma consulta do sistema roda sem filtrar por organizacaoId.
model Organizacao {
  id           String  @id @default(cuid())
  nome         String
  razaoSocial  String?
  cnpj         String? @unique
  emailContato String?
  telefone     String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?

  /// Logo do proprio assinante, usado no cabecalho dos documentos que ele
  /// gera. Guardado no banco para nao depender de servico de arquivos.
  logo     Bytes?
  logoTipo String?

  /// Foro eleito padrao nos contratos gerados por este assinante.
  foroCidade String?
  foroUf     String?

  // ----- assinatura paga -----
  plano            String    @default("TESTE") // TESTE | ESSENCIAL | PROFISSIONAL | MESA
  statusAssinatura String    @default("TESTE") // TESTE | ATIVA | INADIMPLENTE | CANCELADA
  testeExpiraEm    DateTime?
  assinaturaAte    DateTime?

  asaasCustomerId     String?
  asaasSubscriptionId String?

  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios   Usuario[]
  pessoas    Pessoa[]
  operacoes  Operacao[]
  documentos Documento[]
  consultas  Consulta[]
  auditorias Auditoria[]
  certidoes  Certidao[]
  pedidos    Pedido[]
  consumos   Consumo[]
  logs       LogAuditoria[]

  // A solucao de Licitacoes NAO aparece aqui: tem conta e login proprios
  // (LicitacaoConta/LicitacaoUsuario), sem relacao nenhuma com Organizacao.

  @@index([statusAssinatura])
}

// ---------------------------------------------------------------------
// USUARIO
// ---------------------------------------------------------------------

/// Pessoa que entra no sistema. Pertence a uma Organizacao.
/// Os dados civis (CPF, endereco...) existem porque o usuario costuma
/// figurar como INTERMEDIARIO nos documentos que ele mesmo gera.
model Usuario {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  nome         String
  email        String  @unique
  passwordHash String
  papel        String  @default("OPERADOR") // DONO | OPERADOR | LEITOR
  /// Administrador da plataforma (equipe da empresa gestora), enxerga o painel
  /// de assinantes. Nada a ver com "DONO", que e o dono de uma organizacao.
  admin        Boolean @default(false)
  ativo        Boolean @default(true)

  telefone      String?
  cpf           String?
  rg            String?
  nacionalidade String? @default("brasileiro(a)")
  estadoCivil   String?
  profissao     String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?

  /// Verificacao em duas etapas (Google Authenticator e semelhantes).
  totpSegredo     String?
  totpAtivado     Boolean   @default(false)
  totpAtivadoEm   DateTime?
  /// Codigos de recuperacao embaralhados, um uso cada.
  totpRecuperacao String?

  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  documentosCriados Documento[]    @relation("DocumentoAutor")
  consultas         Consulta[]
  logs              LogAuditoria[]

  @@index([organizacaoId])
}

// ---------------------------------------------------------------------
// CADASTRO DE PARTES
// ---------------------------------------------------------------------

/// Qualquer pessoa fisica ou juridica que aparece numa operacao: cedente,
/// cessionario, intermediario, testemunha, anuente.
/// A qualificacao completa existe porque e ela que entra nos contratos.
model Pessoa {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  tipo              String // PF | PJ
  nome              String // nome civil ou razao social
  nomeFantasia      String?
  documento         String? // CPF ou CNPJ, guardado so com numeros
  rg                String?
  orgaoEmissor      String?
  inscricaoEstadual String?

  nacionalidade  String?   @default("brasileiro(a)")
  estadoCivil    String?
  profissao      String?
  dataNascimento DateTime?

  email    String?
  telefone String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?
  enderecoPais        String? @default("Brasil")

  // ----- representante legal (quando PJ, ou PF representada) -----
  repNome          String?
  repCpf           String?
  repRg            String?
  repCargo         String?
  repNacionalidade String?
  repEstadoCivil   String?
  repProfissao     String?
  repEmail         String?

  // ----- compliance / PLD-FT -----
  /// Pessoa Exposta Politicamente (Circular Bacen e Lei 9.613/98).
  pep         Boolean @default(false)
  pepDetalhe  String?
  observacoes String?

  // ----- resultado da ultima auditoria -----
  // Copiado da auditoria mais recente para que a lista e as travas nao
  // precisem consultar o dossie inteiro a cada tela.
  /// SEM_APONTAMENTO | ATENCAO | RESTRICAO
  situacaoCompliance  String?
  complianceEm        DateTime?
  /// SUFICIENTE | LIMITADA | INSUFICIENTE | NAO_AVALIADA
  capacidadePagamento String?
  /// 0 a 100. Quanto maior, melhor. Serve para ordenar, nao para decidir sozinho.
  pontuacao           Int?

  /// Enquanto true, a parte nao entra em documento nem em operacao nova.
  /// E ligada automaticamente quando a auditoria encontra restricao.
  bloqueada              Boolean   @default(false)
  /// Liberacao manual de uma parte bloqueada, sempre com justificativa e autor.
  liberadaPorId          String?
  liberadaEm             DateTime?
  justificativaLiberacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  partes     ParteOperacao[]
  consultas  Consulta[]
  auditorias Auditoria[]
  certidoes  Certidao[]
  pedidos    Pedido[]

  @@index([organizacaoId])
  @@index([organizacaoId, documento])
}

// ---------------------------------------------------------------------
// OPERACAO (o negocio sendo intermediado)
// ---------------------------------------------------------------------

model Operacao {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  /// Codigo curto e sequencial dentro da organizacao: OP-0001.
  codigo    String
  titulo    String
  tipoAtivo String // PRECATORIO | CREDITO_ICMS | CREDITO_PIS_COFINS | CREDITO_TRIBUTARIO | CREDITO_RURAL | CREDAQ | COMMODITY | OURO | METAIS | DIREITO_CREDITORIO | IMOVEL | OUTRO
  descricao String?

  // ----- numeros do negocio -----
  moeda              String   @default("BRL")
  valorFace          Decimal? @db.Decimal(18, 2)
  desagioPercentual  Decimal? @db.Decimal(7, 4)
  valorNegociado     Decimal? @db.Decimal(18, 2)
  comissaoPercentual Decimal? @db.Decimal(7, 4)
  comissaoValor      Decimal? @db.Decimal(18, 2)

  // ----- especifico de precatorio / credito judicial -----
  tribunal         String?
  numeroPrecatorio String?
  numeroProcesso   String?
  enteDevedor      String?
  esferaDevedor    String? // FEDERAL | ESTADUAL | MUNICIPAL | AUTARQUIA
  naturezaCredito  String? // ALIMENTAR | COMUM
  anoOrcamentario  Int?

  // ----- especifico de credito tributario -----
  tributo       String?
  ufCredito     String?
  processoAdmin String?
  homologado    Boolean?

  // ----- especifico de commodity, ouro e metais -----
  produto    String?
  quantidade Decimal? @db.Decimal(18, 4)
  unidade    String?
  incoterm   String?
  origem     String?
  destino    String?
  embarque   String?

  // ----- especifico de ouro e metais -----
  /// Teor / pureza declarada: 999, 9999, 24k, ou percentual do elemento.
  teor            String?
  /// Forma fisica: barra, dore, granulado, lingote, minerio bruto.
  forma           String?
  /// Laudo de ensaio: laboratorio, numero e data. E o que sustenta o teor.
  laudoEnsaio     String?
  /// Titulo minerario ou registro na ANM da area de origem.
  tituloMinerario String?

  fase         String  @default("PROSPECCAO") // PROSPECCAO | NDA | DUE_DILIGENCE | PROPOSTA | CONTRATO | LIQUIDACAO | CONCLUIDA | CANCELADA
  /// Operacao sob sigilo: so quem esta na lista de acesso enxerga o detalhe.
  confidencial Boolean @default(true)

  dataPrevista DateTime?
  encerradaEm  DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  partes     ParteOperacao[]
  documentos Documento[]
  consultas  Consulta[]
  auditorias Auditoria[]
  certidoes  Certidao[]
  pedidos    Pedido[]

  @@unique([organizacaoId, codigo])
  @@index([organizacaoId, fase])
}

/// Liga uma Pessoa a uma Operacao com um papel. A mesma pessoa pode ter mais
/// de um papel na mesma operacao (ex: intermediario e representante).
model ParteOperacao {
  id         String   @id @default(cuid())
  operacaoId String
  operacao   Operacao @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  pessoaId   String
  pessoa     Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  papel String // CEDENTE | CESSIONARIO | INTERMEDIARIO | REPRESENTANTE | TESTEMUNHA | ANUENTE | GARANTIDOR | INVESTIDOR | DIVULGADOR | RECEPTOR | MANDATARIO_VENDA | MANDATARIO_COMPRA

  /// Percentual de comissao desta parte, quando intermediario.
  comissaoPercentual Decimal? @db.Decimal(7, 4)
  /// Posicao na cadeia de intermediacao — e o que o NCNDA protege.
  ordemCadeia        Int?
  observacao         String?

  criadoEm DateTime @default(now())

  @@unique([operacaoId, pessoaId, papel])
  @@index([pessoaId])
}

// ---------------------------------------------------------------------
// DOCUMENTOS
// ---------------------------------------------------------------------

model Documento {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  operacaoId    String?
  operacao      Operacao?   @relation(fields: [operacaoId], references: [id], onDelete: SetNull)

  tipo   String // NDA | NCNDA | IMFPA | PROCURACAO | MANDATO | CESSAO_CREDITO | CESSAO_DIREITOS | CESSAO_PRECATORIO | LOI | TERMO_COMISSAO | DECLARACAO_ORIGEM | TERMO_QUITACAO | ADITIVO | DISTRATO
  titulo String
  versao Int    @default(1)

  /// Retrato dos dados usados na geracao. Guardado para que o documento possa
  /// ser reproduzido identico mesmo depois de o cadastro mudar.
  dados Json

  arquivoNome String
  arquivo     Bytes?
  /// Impressao digital do arquivo (SHA-256). Permite provar depois que o
  /// documento nao foi alterado — e parte da credibilidade da plataforma.
  hashSha256  String?

  status String @default("GERADO") // RASCUNHO | GERADO | ENVIADO_ASSINATURA | ASSINADO | CANCELADO

  assinaturaProvedor   String? // AUTENTIQUE
  assinaturaProvedorId String?
  assinaturaLink       String?
  assinadoEm           DateTime?

  criadoPorId String?
  criadoPor   Usuario? @relation("DocumentoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([organizacaoId, tipo])
  @@index([operacaoId])
}

// ---------------------------------------------------------------------
// AUDITORIA / DUE DILIGENCE
// ---------------------------------------------------------------------

/// Dossie de auditoria de uma parte: o conjunto de consultas feitas de uma vez,
/// mais a leitura do que elas significam.
///
/// Existe como registro proprio, e nao como campo na Pessoa, porque a auditoria
/// se repete no tempo: a empresa idonea de hoje pode estar inapta em seis meses,
/// e a comparacao entre dossies e o que mostra isso.
model Auditoria {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  pessoaId String
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  /// Operacao que motivou a auditoria, quando houver. E dela que sai o valor
  /// contra o qual a capacidade de pagamento e medida.
  operacaoId String?
  operacao   Operacao? @relation(fields: [operacaoId], references: [id], onDelete: SetNull)

  situacao String @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDA | ERRO

  /// SEM_APONTAMENTO | ATENCAO | RESTRICAO
  idoneidade String?
  /// SUFICIENTE | LIMITADA | INSUFICIENTE | NAO_AVALIADA
  capacidade String?
  pontuacao  Int?

  /// Leitura do resultado em linguagem simples, para quem nao e do ramo.
  parecer      String?
  /// Lista estruturada: [{ gravidade, titulo, detalhe, fonte }]
  apontamentos Json?

  /// Valor considerado na analise de capacidade de pagamento.
  valorReferencia Decimal? @db.Decimal(18, 2)
  /// Retrato do cadastro da Receita no momento da auditoria.
  dadosCadastrais Json?

  /// Fontes que nao puderam ser consultadas (sem chave, fora do ar, sem suporte).
  fontesIndisponiveis Json?

  solicitadoPorId String?
  criadoEm        DateTime  @default(now())
  concluidaEm     DateTime?

  consultas Consulta[]

  @@index([organizacaoId, criadoEm])
  @@index([pessoaId, criadoEm])
}

/// Uma consulta feita a uma fonte externa (processos, certidoes, bureau).
/// A resposta bruta fica guardada para servir de prova do que foi consultado
/// e em que data.
model Consulta {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  pessoaId    String?
  pessoa      Pessoa?    @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  operacaoId  String?
  operacao    Operacao?  @relation(fields: [operacaoId], references: [id], onDelete: SetNull)
  auditoriaId String?
  auditoria   Auditoria? @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  fonte     String // RECEITA_CNPJ | CEIS | CNEP | CEPIM | SANCOES_OFAC | DATAJUD | BUREAU | PROTESTO | IA_DOCUMENTO
  parametro String // o que foi consultado: CPF, CNPJ, numero do processo...

  status        String  @default("PENDENTE") // PENDENTE | CONCLUIDA | ERRO
  resultado     Json?
  /// Leitura em linguagem simples do que a consulta encontrou.
  resumo        String?
  /// SEM_APONTAMENTO | ATENCAO | RESTRICAO
  classificacao String?
  erro          String?

  solicitadoPorId String?
  solicitadoPor   Usuario? @relation(fields: [solicitadoPorId], references: [id], onDelete: SetNull)

  criadoEm    DateTime  @default(now())
  concluidaEm DateTime?

  @@index([organizacaoId, fonte])
  @@index([pessoaId])
}

/// Certidao exigida de uma parte e o que ela revelou.
///
/// Existe porque nenhuma base criminal publica e consultavel por robo: o BNMP
/// exige autenticacao, a Policia Federal esta atras de protecao anti-robo e a
/// consulta de improbidade do CNJ tem captcha. O caminho que funciona e exigir
/// a certidao da propria parte, guardar o arquivo e travar a operacao enquanto
/// faltar.
model Certidao {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  pessoaId String
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  /// Operacao que exigiu esta certidao, quando for exigencia especifica dela.
  operacaoId String?
  operacao   Operacao? @relation(fields: [operacaoId], references: [id], onDelete: SetNull)

  /// Chave do catalogo em src/lib/auditoria/certidoes.ts
  tipo         String
  orgaoEmissor String?
  numero       String?

  emitidaEm DateTime?
  validaAte DateTime?

  /// PENDENTE | NADA_CONSTA | CONSTA
  resultado String @default("PENDENTE")

  /// O que exatamente consta, quando consta.
  apontamento String?

  /// A distincao que muda tudo na leitura de uma certidao criminal:
  /// NENHUMA | PROCESSO_EM_CURSO | CONDENACAO_TRANSITADA | MANDADO_ABERTO |
  /// MEDIDA_CONSTRITIVA | OUTRO
  /// Processo em curso nao e condenacao (presuncao de inocencia; Sum. 444 STJ).
  natureza String @default("NENHUMA")

  arquivo     Bytes?
  arquivoNome String?
  arquivoTipo String?
  hashSha256  String?

  /// Emitida pela consulta automatica, e nao apresentada pela parte.
  emissaoAutomatica Boolean @default(false)
  /// Endereco do comprovante no provedor. Guardado alem do arquivo porque o
  /// endereco pode expirar, e o arquivo nao.
  comprovanteUrl    String?
  /// Resposta completa da consulta: e a prova do que foi visto e quando.
  dadosConsulta     Json?

  registradaPorId String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([organizacaoId, pessoaId])
  @@index([pessoaId, tipo])
}

// ---------------------------------------------------------------------
// DIVIDA ATIVA DA UNIAO
// ---------------------------------------------------------------------

/// Inscricao em divida ativa da Uniao, vinda dos dados abertos da PGFN.
///
/// POR QUE OS DADOS FICAM AQUI DENTRO, E NAO SAO CONSULTADOS AO VIVO:
/// o portal Divida Aberta da PGFN usa hCaptcha invisivel e recusa robo. Mas a
/// propria PGFN publica a base inteira em dados abertos, por trimestre, em
/// https://dadosabertos.pgfn.gov.br — feita para uso em massa. Baixamos,
/// carregamos aqui e consultamos localmente: legitimo, instantaneo e sem
/// depender de site no ar.
///
/// ATENCAO AO CPF: nos arquivos publicos o CNPJ vem completo, mas o CPF vem
/// MASCARADO (XXX878.325XX). Para pessoa fisica so da para casar os seis
/// digitos do meio mais o nome — e isso levanta suspeita, nao identifica.
model DividaAtivaUniao {
  id String @id @default(cuid())

  /// Documento como veio no arquivo, so com numeros e letras.
  documento  String
  /// Os seis digitos visiveis do CPF mascarado. Nulo quando e CNPJ.
  cpfMiolo   String?
  tipoPessoa String // PF | PJ

  nome            String
  nomeNormalizado String // sem acento, maiusculas — para casar pessoa fisica
  uf              String?

  /// FGTS | PREVIDENCIARIO | NAO_PREVIDENCIARIO
  tipoDivida String

  numeroInscricao  String
  /// Em cobranca | Beneficio Fiscal | Garantia
  tipoSituacao     String?
  /// INSCRITA | AJUIZADA | PROTESTADA | EMBARGADA | PARCELAMENTO...
  situacao         String?
  receitaPrincipal String?
  dataInscricao    DateTime?
  ajuizado         Boolean   @default(false)
  valorConsolidado Decimal   @db.Decimal(18, 2)

  /// Trimestre de origem do arquivo: 2026_trimestre_02.
  origem String

  @@index([documento])
  @@index([cpfMiolo])
  @@index([nomeNormalizado])
}

/// Controle das cargas de dados abertos, para o sistema saber o que ja tem e
/// o que ficou de fora — e poder dizer isso no parecer.
model CargaDados {
  id String @id @default(cuid())

  fonte      String // PGFN_DIVIDA_ATIVA
  /// FGTS | PREVIDENCIARIO | NAO_PREVIDENCIARIO
  conjunto   String
  /// Trimestre carregado: 2026_trimestre_02.
  referencia String

  situacao  String  @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDA | ERRO
  registros Int     @default(0)
  erro      String?

  iniciadaEm  DateTime  @default(now())
  concluidaEm DateTime?

  @@unique([fonte, conjunto])
}

// ---------------------------------------------------------------------
// COMPRAS AVULSAS E CONSUMO
// ---------------------------------------------------------------------

/// Compra avulsa: uma consulta, uma assinatura eletronica ou uma due
/// diligence, pagas por unidade e nao pela mensalidade.
///
/// Existe porque nem todo trabalho cabe em plano: quem faz duas operacoes por
/// ano nao assina mensalidade, mas paga por uma due diligence quando precisa —
/// e o assinante que estoura o incluido no plano tambem compra avulso em vez
/// de ser obrigado a subir de faixa.
model Pedido {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  /// Numero curto e sequencial: PD-0001.
  numero String

  /// Chave do catalogo em src/lib/avulsos.ts
  item          String
  descricao     String
  quantidade    Int     @default(1)
  valorUnitario Decimal @db.Decimal(18, 2)
  valorTotal    Decimal @db.Decimal(18, 2)

  /// A que a compra se refere, quando aplicavel.
  pessoaId   String?
  pessoa     Pessoa?   @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  operacaoId String?
  operacao   Operacao? @relation(fields: [operacaoId], references: [id], onDelete: SetNull)

  /// AGUARDANDO_PAGAMENTO | PAGO | EM_EXECUCAO | ENTREGUE | CANCELADO | ESTORNADO
  situacao String @default("AGUARDANDO_PAGAMENTO")

  // ----- pagamento -----
  asaasCobrancaId String?
  linkPagamento   String?
  formaPagamento  String? // PIX | BOLETO | CARTAO
  pagoEm          DateTime?

  // ----- entrega -----
  /// Prazo prometido, em dias uteis, conforme o catalogo.
  prazoUteis   Int?
  prometidoAte DateTime?
  entregueEm   DateTime?
  /// Documento gerado como resultado, quando houver.
  documentoId  String?
  /// Resultado de consulta avulsa, quando nao gera documento.
  resultado    Json?

  observacao String?

  solicitadoPorId String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([organizacaoId, numero])
  @@index([organizacaoId, situacao])
}

/// Quanto de cada coisa o assinante usou no mes.
///
/// E o que permite dizer "voce ja usou 100 das 100 leituras incluidas" antes de
/// cobrar avulso — e nao depois. Cobranca surpresa em software de assinatura e
/// o caminho mais rapido para o cancelamento.
model Consumo {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  /// LEITURA_IA | ASSINATURA | BUREAU | DOCUMENTO
  tipo        String
  /// Mes de referencia no formato AAAA-MM.
  competencia String

  quantidade Int @default(0)

  atualizadoEm DateTime @updatedAt

  @@unique([organizacaoId, tipo, competencia])
  @@index([organizacaoId, competencia])
}

/// Registro de quem fez o que. Nunca e apagado nem editado pelo sistema.
model LogAuditoria {
  id            String       @id @default(cuid())
  organizacaoId String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)
  usuarioId     String?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  acao       String // LOGIN | LOGIN_FALHA | CRIAR | EDITAR | EXCLUIR | GERAR_DOCUMENTO | ENVIAR_ASSINATURA | CONSULTAR | EXPORTAR
  entidade   String?
  entidadeId String?
  detalhe    Json?

  ip     String?
  agente String?

  criadoEm DateTime @default(now())

  @@index([organizacaoId, criadoEm])
  @@index([entidade, entidadeId])
}

/// Tentativas de login por e-mail, para travar quem fica testando senha.
model TentativaLogin {
  id       String   @id @default(cuid())
  email    String
  ip       String?
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
}

// =====================================================================
// LICITAÇÕES
//
// Solução isolada: nenhum modelo abaixo referencia Pessoa, Operacao ou
// ParteOperacao, que pertencem à solução de gestão de ativos. É regra do
// produto — cada solução tem seu próprio cadastro, sem tabela compartilhada
// entre soluções, mesmo quando os dados parecem os mesmos (uma empresa
// licitante "parece" uma Pessoa PJ comum; ainda assim, tem tabela própria).
//
// A solução tem duas frentes, e elas TAMBÉM não se comunicam entre si:
//
//   FRENTE DO LICITANTE — a empresa organiza o próprio dossiê de habilitação
//   e monta o envelope de um edital que ela escolheu.
//
//   FRENTE DO ENTE PÚBLICO — a prefeitura analisa os participantes que se
//   apresentaram a um certame dela, verificando documentação e assinatura.
//
// A mesma empresa do mundo real pode aparecer em LicitanteEmpresa (pelo
// próprio cadastro) e em ParticipanteCertame (pelo olhar da prefeitura que
// recebeu a documentação dela) sem que um registro aponte para o outro.
//
// O isolamento vale também para o LOGIN: cada solução tem sua própria conta,
// sua própria senha e sua própria verificação em duas etapas. Quem assina
// Licitações entra por uma porta própria (LicitacaoConta/LicitacaoUsuario),
// nunca pela conta que assina a Gestão de Ativos (Organizacao/Usuario) —
// mesmo que seja a mesma empresa do mundo real assinando as duas soluções.
// =====================================================================

// ---------------------------------------------------------------------
// CONTA E LOGIN — próprios desta solução
// ---------------------------------------------------------------------

/// O assinante da solução de Licitações. Equivalente a `Organizacao`, mas
/// sem nenhuma relação com ela: é o "conta" desta solução, não da Gestão de
/// Ativos. Serve tanto o licitante (empresa ou profissional autônomo) quanto
/// o ente público, porque os dois usam a mesma solução por frentes distintas.
model LicitacaoConta {
  id String @id @default(cuid())

  tipo        String // PF | PJ
  nome        String
  razaoSocial String?
  /// CPF quando tipo=PF, CNPJ quando tipo=PJ.
  documento   String?

  emailContato String?
  telefone     String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?

  // ----- cobrança: o cliente escolhe, entre as tres formas -----
  formaCobranca    String    @default("ASSINATURA") // AVULSO | CREDITO | ASSINATURA
  plano            String    @default("TESTE") // TESTE | ESSENCIAL | PROFISSIONAL | MESA
  statusAssinatura String    @default("TESTE") // TESTE | ATIVA | INADIMPLENTE | CANCELADA
  testeExpiraEm    DateTime?
  assinaturaAte    DateTime?
  /// Saldo do crédito pré-pago, quando formaCobranca = CREDITO.
  saldoCredito     Decimal   @default(0) @db.Decimal(12, 2)

  asaasCustomerId     String?
  asaasSubscriptionId String?

  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios          LicitacaoUsuario[]
  licitantesEmpresa LicitanteEmpresa[]
  editaisInteresse  EditalInteresse[]
  envelopes         Envelope[]
  certames          Certame[]
  auditorias        LicitanteAuditoria[]

  @@index([statusAssinatura])
}

/// Quem entra no painel da solução de Licitações. Equivalente a `Usuario`,
/// mas com senha, sessão e verificação em duas etapas inteiramente próprias
/// — logar aqui não abre nem depende da conta da Gestão de Ativos.
model LicitacaoUsuario {
  id               String         @id @default(cuid())
  licitacaoContaId String
  licitacaoConta   LicitacaoConta @relation(fields: [licitacaoContaId], references: [id], onDelete: Cascade)

  nome         String
  email        String  @unique
  passwordHash String
  papel        String  @default("OPERADOR") // DONO | OPERADOR | LEITOR
  ativo        Boolean @default(true)

  /// Verificação em duas etapas (aplicativo autenticador), própria desta
  /// solução — o segredo de um login não vale para o outro.
  totpSegredo     String?
  totpAtivado     Boolean   @default(false)
  totpAtivadoEm   DateTime?
  totpRecuperacao String?

  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([licitacaoContaId])
}

/// Tentativas de login da solução de Licitações — travadas separadamente da
/// Gestão de Ativos, para o limite de uma não valer para a outra.
model LicitacaoTentativaLogin {
  id       String   @id @default(cuid())
  email    String
  ip       String?
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
}

// ---------------------------------------------------------------------
// FRENTE DO LICITANTE
// ---------------------------------------------------------------------

/// Cadastro da empresa que participa de licitações — próprio da solução,
/// preenchido uma vez e reaproveitado em qualquer certame.
model LicitanteEmpresa {
  id               String         @id @default(cuid())
  licitacaoContaId String
  licitacaoConta   LicitacaoConta @relation(fields: [licitacaoContaId], references: [id], onDelete: Cascade)

  nome              String
  documento         String // CNPJ
  inscricaoEstadual String?
  microempresaOuEpp Boolean @default(false)

  emailContato String?
  telefone     String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?

  // ----- representante legal, para as declaracoes e o credenciamento -----
  repNome          String?
  repCpf           String?
  repRg            String?
  repCargo         String?
  repNacionalidade String?
  repEstadoCivil   String?
  repProfissao     String?

  // ----- resultado da ultima auditoria de compliance -----
  // Cache do que a auditoria mais recente encontrou, no mesmo espirito do
  // que Pessoa guarda para a gestao de ativos — mas em coluna propria desta
  // tabela, nao na tabela da outra solucao.
  /// SEM_APONTAMENTO | ATENCAO | RESTRICAO
  situacaoCompliance  String?
  complianceEm        DateTime?
  /// SUFICIENTE | LIMITADA | INSUFICIENTE | NAO_AVALIADA
  capacidadePagamento String?
  pontuacao           Int?
  /// Enquanto true, nao deveria gerar envelope novo sem revisao manual.
  bloqueada           Boolean   @default(false)
  /// Liberacao manual da restricao — so sai do bloqueio com confirmacao
  /// humana registrada, nunca automaticamente.
  liberadaPorNome        String?
  liberadaEm             DateTime?
  justificativaLiberacao String?

  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  documentosPessoais LicitanteDocumentoPessoal[]
  envelopes          Envelope[]
  auditorias         LicitanteAuditoria[]

  @@index([licitacaoContaId])
  @@index([licitacaoContaId, documento])
}

/// Auditoria de compliance da empresa licitante — tabela propria desta
/// solucao, no formato de Auditoria (gestao de ativos), mas sem nenhuma
/// chave estrangeira para Pessoa ou Operacao.
model LicitanteAuditoria {
  id                 String           @id @default(cuid())
  licitacaoContaId   String
  licitacaoConta     LicitacaoConta   @relation(fields: [licitacaoContaId], references: [id], onDelete: Cascade)
  licitanteEmpresaId String
  licitanteEmpresa   LicitanteEmpresa @relation(fields: [licitanteEmpresaId], references: [id], onDelete: Cascade)

  situacao String @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDA | ERRO

  idoneidade   String? // SEM_APONTAMENTO | ATENCAO | RESTRICAO
  capacidade   String? // SUFICIENTE | LIMITADA | INSUFICIENTE | NAO_AVALIADA
  pontuacao    Int?
  parecer      String?
  apontamentos Json?

  dadosCadastrais     Json?
  fontesIndisponiveis Json?

  solicitadoPorId String?
  criadoEm        DateTime  @default(now())
  concluidaEm     DateTime?

  consultas LicitanteConsulta[]

  @@index([licitacaoContaId, criadoEm])
  @@index([licitanteEmpresaId, criadoEm])
}

/// Uma consulta a fonte externa, feita para auditar a empresa licitante.
model LicitanteConsulta {
  id                   String              @id @default(cuid())
  licitacaoContaId     String
  licitanteEmpresaId   String
  licitanteAuditoriaId String?
  licitanteAuditoria   LicitanteAuditoria? @relation(fields: [licitanteAuditoriaId], references: [id], onDelete: Cascade)

  fonte     String // RECEITA_CNPJ | CEIS | CNEP | CEPIM | SANCOES_OFAC | DIVIDA_ATIVA | BUREAU
  parametro String

  status    String  @default("PENDENTE") // PENDENTE | CONCLUIDA | ERRO
  resultado Json?
  resumo    String?
  erro      String?

  criadoEm    DateTime  @default(now())
  concluidaEm DateTime?

  @@index([licitacaoContaId, fonte])
  @@index([licitanteEmpresaId])
}

/// Documento pessoal do representante — RG, comprovante de residência e
/// afins. É o que falta depois das declarações geradas: a plataforma monta
/// tudo o que pode a partir do cadastro, e isto aqui é o que só a própria
/// pessoa consegue apresentar.
model LicitanteDocumentoPessoal {
  id                 String           @id @default(cuid())
  licitanteEmpresaId String
  licitanteEmpresa   LicitanteEmpresa @relation(fields: [licitanteEmpresaId], references: [id], onDelete: Cascade)

  tipo        String // RG | CPF | COMPROVANTE_RESIDENCIA | CONTRATO_SOCIAL | OUTRO
  nomeArquivo String
  arquivo     Bytes
  arquivoTipo String? // image/jpeg | application/pdf | ...

  enviadoEm DateTime @default(now())

  @@index([licitanteEmpresaId])
}

/// Um edital que a empresa trouxe porque tem interesse em participar.
model EditalInteresse {
  id               String         @id @default(cuid())
  licitacaoContaId String
  licitacaoConta   LicitacaoConta @relation(fields: [licitacaoContaId], references: [id], onDelete: Cascade)

  orgaoLicitante String
  modalidade     String
  numeroCertame  String
  objeto         String?

  arquivoNome String?
  arquivo     Bytes?

  prazoEnvio DateTime?

  criadoEm DateTime @default(now())

  envelopes Envelope[]

  @@index([licitacaoContaId])
}

/// O pacote de submissão: identifica o certame e a empresa, e reúne as
/// declarações geradas com os documentos pessoais anexados. É a resposta
/// concreta a "reunir toda a documentação, já pronta para anexar".
model Envelope {
  id                 String           @id @default(cuid())
  licitacaoContaId   String
  licitacaoConta     LicitacaoConta   @relation(fields: [licitacaoContaId], references: [id], onDelete: Cascade)
  licitanteEmpresaId String
  licitanteEmpresa   LicitanteEmpresa @relation(fields: [licitanteEmpresaId], references: [id], onDelete: Cascade)
  editalInteresseId  String
  editalInteresse    EditalInteresse  @relation(fields: [editalInteresseId], references: [id], onDelete: Cascade)

  status String @default("MONTAGEM") // MONTAGEM | COMPLETO | ENVIADO

  /// Registro de quais declarações e documentos entraram, e o hash de cada
  /// arquivo gerado, para provar depois que o envelope não foi alterado.
  itens Json

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([licitacaoContaId])
  @@index([licitanteEmpresaId])
}

// ---------------------------------------------------------------------
// FRENTE DO ENTE PÚBLICO
// ---------------------------------------------------------------------

/// O certame gerenciado pela prefeitura ou órgão — onde ela cadastra os
/// participantes que se apresentaram, para qualificação.
model Certame {
  id               String         @id @default(cuid())
  licitacaoContaId String
  licitacaoConta   LicitacaoConta @relation(fields: [licitacaoContaId], references: [id], onDelete: Cascade)

  orgaoLicitante String
  modalidade     String
  numeroCertame  String
  objeto         String?

  arquivoEditalNome String?
  arquivoEdital     Bytes?

  dataSessao DateTime?
  fase       String    @default("ANALISE") // ANALISE | CONCLUIDO | CANCELADO

  criadoEm DateTime @default(now())

  participantes ParticipanteCertame[]

  @@index([licitacaoContaId])
}

/// Um participante do certame, pelo olhar da prefeitura — não é a mesma
/// tabela de LicitanteEmpresa, mesmo quando descreve a mesma empresa: a
/// prefeitura só enxerga o que o participante apresentou a ela.
model ParticipanteCertame {
  id        String  @id @default(cuid())
  certameId String
  certame   Certame @relation(fields: [certameId], references: [id], onDelete: Cascade)

  nome      String
  documento String // CNPJ apresentado

  situacao String @default("EM_ANALISE") // EM_ANALISE | QUALIFICADO | INABILITADO

  /// Motivo da qualificação ou inabilitação, requisito por requisito —
  /// preenchido conforme a taxonomia fechada de src/lib/licitacoes/requisitos.ts.
  parecer Json?

  // ----- resultado automatico da verificacao de compliance -----
  // Separado de `situacao`/`parecer` de proposito: aqueles sao a DECISAO da
  // comissao; isto e o INSUMO automatico que ajuda a decidir. A comissao
  // pode divergir do resultado automatico, e o registro de que divergiu
  // fica no parecer, nao aqui.
  complianceIdoneidade String? // SEM_APONTAMENTO | ATENCAO | RESTRICAO
  complianceEm         DateTime?
  compliancePontuacao  Int?

  criadoEm DateTime @default(now())

  documentos DocumentoParticipante[]
  auditorias ParticipanteAuditoria[]

  @@index([certameId])
}

/// Auditoria de compliance do participante — pelo olhar da prefeitura.
/// Mesma logica de verificacao da LicitanteAuditoria, tabela propria.
model ParticipanteAuditoria {
  id                    String              @id @default(cuid())
  participanteCertameId String
  participanteCertame   ParticipanteCertame @relation(fields: [participanteCertameId], references: [id], onDelete: Cascade)

  situacao String @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDA | ERRO

  idoneidade   String?
  capacidade   String?
  pontuacao    Int?
  parecer      String?
  apontamentos Json?

  dadosCadastrais     Json?
  fontesIndisponiveis Json?

  criadoEm    DateTime  @default(now())
  concluidaEm DateTime?

  consultas ParticipanteConsulta[]

  @@index([participanteCertameId, criadoEm])
}

model ParticipanteConsulta {
  id                      String                 @id @default(cuid())
  participanteCertameId   String
  participanteAuditoriaId String?
  participanteAuditoria   ParticipanteAuditoria? @relation(fields: [participanteAuditoriaId], references: [id], onDelete: Cascade)

  fonte     String
  parametro String

  status    String  @default("PENDENTE")
  resultado Json?
  resumo    String?
  erro      String?

  criadoEm    DateTime  @default(now())
  concluidaEm DateTime?

  @@index([participanteCertameId])
}

/// Documento apresentado pelo participante para aquele certame — o que se
/// confere quanto a autenticidade e a assinatura.
model DocumentoParticipante {
  id                    String              @id @default(cuid())
  participanteCertameId String
  participanteCertame   ParticipanteCertame @relation(fields: [participanteCertameId], references: [id], onDelete: Cascade)

  tipo        String // requisito da taxonomia (ex.: CERTIDAO_FGTS) ou "OUTRO"
  nomeArquivo String
  arquivo     Bytes
  arquivoTipo String?

  /// Se o mesmo documento existe emitido direto na fonte oficial, para
  /// comparar o apresentado contra o que o orgao emissor responde hoje.
  autenticidadeConferida Boolean @default(false)
  autenticidadeResultado String? // CONFERE | DIVERGE | NAO_VERIFICAVEL

  assinatura ValidacaoAssinatura?

  enviadoEm DateTime @default(now())

  @@index([participanteCertameId])
}

/// Validação da assinatura de um documento apresentado.
///
/// Assinatura digital tem certificado verificável na fonte (ICP-Brasil,
/// gov.br, ou o provedor de assinatura eletrônica) — isso a plataforma
/// confere de verdade. Assinatura manuscrita, escaneada, não tem base
/// pública de comparação automática confiável: o que a plataforma oferece
/// aqui é colocar as duas assinaturas lado a lado para o analista comparar,
/// não um veredito automático de "é genuína". Prometer isso seria exatamente
/// o tipo de afirmação que a própria auditoria da plataforma trata como
/// risco quando encontra numa contraparte.
model ValidacaoAssinatura {
  id                      String                @id @default(cuid())
  documentoParticipanteId String                @unique
  documentoParticipante   DocumentoParticipante @relation(fields: [documentoParticipanteId], references: [id], onDelete: Cascade)

  tipo String // DIGITAL | MANUSCRITA

  // ----- assinatura digital -----
  provedor               String? // ICP_BRASIL | GOV_BR | AUTENTIQUE | OUTRO
  certificadoValido      Boolean?
  identificadorValidacao String? // codigo/URL de verificacao no provedor

  // ----- assinatura manuscrita -----
  /// Nunca "GENUINA" automatico — so registra que foi colocada para
  /// conferencia visual, e o que o analista humano concluiu.
  conferenciaVisualFeitaPor String?
  observacaoAnalista        String?

  resultado String @default("PENDENTE") // PENDENTE | VALIDA | INVALIDA | NAO_VERIFICAVEL

  validadoEm DateTime?
  criadoEm   DateTime  @default(now())
}

// =====================================================================
// COMPLIANCE DE EMPRESAS
//
// Solução isolada, com conta e login próprios — a mesma regra de
// Licitações: nenhuma tabela aqui referencia Organizacao, Usuario, Pessoa
// ou qualquer tabela de outra solução, e o login é inteiramente separado
// (ComplianceConta/ComplianceUsuario), mesmo que o mesmo cliente assine
// mais de uma solução da plataforma.
// =====================================================================

/// O assinante da solução de Compliance de Empresas.
model ComplianceConta {
  id String @id @default(cuid())

  tipo        String // PF | PJ
  nome        String
  razaoSocial String?
  documento   String?

  emailContato String?
  telefone     String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?

  // ----- cobrança: o cliente escolhe, entre as tres formas -----
  formaCobranca    String    @default("ASSINATURA") // AVULSO | CREDITO | ASSINATURA
  plano            String    @default("TESTE")
  statusAssinatura String    @default("TESTE")
  testeExpiraEm    DateTime?
  assinaturaAte    DateTime?
  saldoCredito     Decimal   @default(0) @db.Decimal(12, 2)

  asaasCustomerId     String?
  asaasSubscriptionId String?

  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios ComplianceUsuario[]
  empresas ComplianceEmpresa[]

  @@index([statusAssinatura])
}

/// Quem entra no painel da solução de Compliance de Empresas. Senha e
/// verificação em duas etapas inteiramente próprias desta solução.
model ComplianceUsuario {
  id                String          @id @default(cuid())
  complianceContaId String
  complianceConta   ComplianceConta @relation(fields: [complianceContaId], references: [id], onDelete: Cascade)

  nome         String
  email        String  @unique
  passwordHash String
  papel        String  @default("OPERADOR") // DONO | OPERADOR | LEITOR
  ativo        Boolean @default(true)

  totpSegredo     String?
  totpAtivado     Boolean   @default(false)
  totpAtivadoEm   DateTime?
  totpRecuperacao String?

  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@index([complianceContaId])
}

/// Tentativas de login desta solução, travadas separadamente das demais.
model ComplianceTentativaLogin {
  id       String   @id @default(cuid())
  email    String
  ip       String?
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
}

/// A empresa sendo verificada — o cadastro central desta solução.
model ComplianceEmpresa {
  id                String          @id @default(cuid())
  complianceContaId String
  complianceConta   ComplianceConta @relation(fields: [complianceContaId], references: [id], onDelete: Cascade)

  nome              String
  documento         String // CNPJ
  inscricaoEstadual String?

  emailContato String?
  telefone     String?

  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCidade      String?
  enderecoUf          String?
  enderecoCep         String?

  // ----- resultado da ultima auditoria -----
  /// SEM_APONTAMENTO | ATENCAO | RESTRICAO
  situacaoCompliance  String?
  complianceEm        DateTime?
  /// SUFICIENTE | LIMITADA | INSUFICIENTE | NAO_AVALIADA
  capacidadePagamento String?
  pontuacao           Int?
  bloqueada           Boolean   @default(false)
  /// Liberacao manual da restricao — so sai do bloqueio com confirmacao
  /// humana registrada, nunca automaticamente.
  liberadaPorNome        String?
  liberadaEm             DateTime?
  justificativaLiberacao String?

  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  certidoes  ComplianceCertidao[]
  auditorias ComplianceAuditoria[]
  documentos ComplianceDocumento[]

  @@index([complianceContaId])
  @@index([complianceContaId, documento])
}

/// Auditoria de compliance da empresa — mesmo formato de LicitanteAuditoria,
/// tabela própria desta solução.
model ComplianceAuditoria {
  id                  String            @id @default(cuid())
  complianceContaId   String
  complianceEmpresaId String
  complianceEmpresa   ComplianceEmpresa @relation(fields: [complianceEmpresaId], references: [id], onDelete: Cascade)

  situacao String @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDA | ERRO

  idoneidade   String?
  capacidade   String?
  pontuacao    Int?
  parecer      String?
  apontamentos Json?

  dadosCadastrais     Json?
  fontesIndisponiveis Json?

  solicitadoPorId String?
  criadoEm        DateTime  @default(now())
  concluidaEm     DateTime?

  consultas ComplianceConsulta[]

  @@index([complianceContaId, criadoEm])
  @@index([complianceEmpresaId, criadoEm])
}

model ComplianceConsulta {
  id                    String               @id @default(cuid())
  complianceEmpresaId   String
  complianceAuditoriaId String?
  complianceAuditoria   ComplianceAuditoria? @relation(fields: [complianceAuditoriaId], references: [id], onDelete: Cascade)

  fonte     String
  parametro String

  status    String  @default("PENDENTE")
  resultado Json?
  resumo    String?
  erro      String?

  criadoEm    DateTime  @default(now())
  concluidaEm DateTime?

  @@index([complianceEmpresaId])
}

/// Certidão da empresa — apresentada por ela ou emitida direto na fonte —
/// com prazo de validade. É o que sustenta "certidões emitidas e
/// arquivadas, com controle de validade" no relatório final.
model ComplianceCertidao {
  id                  String            @id @default(cuid())
  complianceEmpresaId String
  complianceEmpresa   ComplianceEmpresa @relation(fields: [complianceEmpresaId], references: [id], onDelete: Cascade)

  tipo   String // CERTIDAO_TRIBUTOS_FEDERAIS | CERTIDAO_FGTS | CNDT | CERTIDAO_FALENCIA_CONCORDATA | OUTRO
  origem String @default("APRESENTADA") // APRESENTADA | EMITIDA

  nomeArquivo String?
  arquivo     Bytes?
  arquivoTipo String?

  emitidaEm DateTime?
  validaAte DateTime?

  criadoEm DateTime @default(now())

  @@index([complianceEmpresaId])
}

/// Relatório de compliance gerado e guardado — arquivo e impressão digital,
/// para provar depois que o documento entregue não foi alterado.
model ComplianceDocumento {
  id                  String            @id @default(cuid())
  complianceEmpresaId String
  complianceEmpresa   ComplianceEmpresa @relation(fields: [complianceEmpresaId], references: [id], onDelete: Cascade)

  titulo      String
  arquivoNome String
  arquivo     Bytes
  hashSha256  String

  criadoEm DateTime @default(now())

  @@index([complianceEmpresaId])
}
