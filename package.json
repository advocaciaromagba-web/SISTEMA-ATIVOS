{
  "name": "sistema-ativos",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma para intermediarios de ativos: CRM de operacoes, geracao de documentos e due diligence",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "setup": "npm install && npx prisma db push && npm run db:seed",
    "admin:criar": "node scripts/criar-admin.mjs",
    "ia:chave": "node scripts/definir-chave-ia.mjs",
    "planos:semear": "node --import ./node_modules/sucrase/register/ts.js scripts/semear-planos.mjs",
    "contratos:rascunho": "node scripts/rascunho-contratos.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "docx": "^9.7.1",
    "next": "16.3.4",
    "next-auth": "^4.24.7",
    "otplib": "^13.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
